[Unit]
Description=Macro Keyboard — hardware macro keyboard with voice-to-text
After=graphical-session.target dbus-session.service

[Service]
Type=simple
# Set up environment for clipboard/X11 tools
Environment=XDG_RUNTIME_DIR=%t
# Find python3 — use the system default
ExecStart=/usr/sbin/python3 %h/code/macrokeyboard/run_macros.py

# Environment — Whisper endpoint, microphone, logging
Environment=STT_ENDPOINT=http://10.0.0.93:9001/v1/audio/transcriptions
Environment=VOICE_DEVICE=plughw:5,0
Environment=LOG_LEVEL=INFO

# Restart on crash
Restart=on-failure
RestartSec=3

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macrokeyboard

[Install]
WantedBy=default.target
